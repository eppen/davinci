{
  "code": "mes-yield-trend",
  "name": "mes-yield-trend",
  "title": "良率趋势",
  "category": "mes",
  "renderer": "echarts",
  "dataSchema": {
    "id": 903,
    "coordinate": "cartesian",
    "rules": [{ "dimension": [1, 1], "metric": [1, 9999] }]
  },
  "styleSchema": [
    { "key": "smooth", "title": "平滑曲线", "component": "switch", "default": true }
  ],
  "optionTemplate": {
    "xAxis": { "type": "category", "data": "{{colValues}}" },
    "yAxis": { "type": "value" },
    "series": [{ "type": "line", "smooth": "{{style.smooth}}", "data": "{{metricValues}}" }]
  }
}
